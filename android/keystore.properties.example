# Copy to keystore.properties (gitignored) and point to your Play upload keystore.
# Create keystore: keytool -genkeypair -v -storetype PKCS12 -keystore upload-keystore.jks -alias upload -keyalg RSA -keysize 2048 -validity 10000
#
# In Play Console: enable Play App Signing and register this certificate as the upload key.

storePassword=your-store-password
keyPassword=your-key-password
keyAlias=upload
storeFile=upload-keystore.jks
