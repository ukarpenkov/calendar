<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Raster art scaled per density (ic_launcher_full.png); background layer is @color/ic_launcher_background. -->
    <item
        android:left="10dp"
        android:top="10dp"
        android:right="10dp"
        android:bottom="10dp">
        <bitmap
            android:gravity="fill"
            android:src="@drawable/ic_launcher_full" />
    </item>
</layer-list>
